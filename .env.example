# ---- Supabase (required: auth + database) ----
# Project Settings -> API  (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase service role (required: background jobs under RLS) ----
# Project Settings -> API Keys -> service_role / secret key.
# Bypasses RLS. Server-only: never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Groq (required: AI newsletter generation) ----
# https://console.groq.com/keys
GROQ_API_KEY=

# ---- NewsAPI (required: article sourcing; falls back to lib/fallback-news.ts) ----
# https://newsapi.org/register
NEWS_API_KEY=

# ---- Gmail SMTP (required: newsletter delivery via nodemailer) ----
# GMAIL_APP_PASSWORD is a 16-char Google App Password, NOT your account password.
# https://myaccount.google.com/apppasswords  (needs 2FA enabled)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Inngest (background jobs / scheduling) ----
# Not needed for `npx inngest-cli@latest dev` locally; required for deployed runs.
# https://app.inngest.com -> Manage -> Event Keys / Signing Key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Public app URL (required: absolute links in emails) ----
# No trailing slash. Locally http://localhost:3000; in production your real domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================================================
# Delivery platform (docs/DESIGN.md)
# ===========================================================================
# The worker and the /api/v1 send API. Independent of the newsletter above --
# the newsletter is one client of this platform, not the other way round.

# ---- Providers, tried in this order: sink -> smtp -> gmail ----
# At least one must be configured or the worker refuses to start.

# Sink: accepts and discards everything. For load testing throughput without
# spending a provider quota. Never enable in production.
SINK_PROVIDER=false
SINK_LATENCY_MS=0
SINK_FAILURE_RATE=0

# Generic SMTP. Point at Mailpit (localhost:1025) to capture real rendered mail
# locally, or at SES/Postmark/Resend SMTP in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_MAX_CONNECTIONS=5

# GMAIL_USER / GMAIL_APP_PASSWORD above double as the last-resort fallback.

# ---- Worker tuning ----
# Jobs claimed per round trip, and sends attempted simultaneously within a batch.
WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=10
# Lease length. Short so a crashed worker's jobs are reclaimed promptly; long
# sends are covered by the heartbeat rather than by raising this.
WORKER_LEASE_SECONDS=60
# Poll interval bounds. Grows while the queue is empty, resets when work appears.
WORKER_MIN_IDLE_MS=250
WORKER_MAX_IDLE_MS=5000
# Grace period for in-flight sends to finish on SIGTERM.
WORKER_SHUTDOWN_GRACE_MS=30000
