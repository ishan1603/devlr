# Copy to .env.local and fill in. SETUP.md walks through each value.
# Everything here runs on a permanent free tier.

# ---- Supabase (required: auth + database) ----------------------------------
# Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Ships to the browser, which is fine: row level
# security is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role / secret key. Bypasses row level security. Server only:
# never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard -> Connect -> Session pooler -> URI. Used only by `npm run db:migrate`.
SUPABASE_DB_URL=

# ---- Language models (at least one, or every issue uses template copy) -----
# https://console.groq.com/keys  -- writing: subject lines, intros, summaries
GROQ_API_KEY=
# https://aistudio.google.com/apikey  -- embeddings (duplicate detection and
# relevance) and the bulk of the summarising. Strongly recommended.
GEMINI_API_KEY=
# Optional extra fallbacks.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Model pins. Leave unset to use the defaults in lib/ai/providers.ts.
# Free tiers retire models without notice; `npm run ai:check` shows what works.
# GROQ_MODEL_LARGE=openai/gpt-oss-120b
# GROQ_MODEL_SMALL=openai/gpt-oss-20b
# GROQ_MODEL_ALT=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- Email (required to send) ----------------------------------------------
# Gmail SMTP: free, about 500 recipients a day. The password is a 16-character
# App Password (https://myaccount.google.com/apppasswords), not your login.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: any SMTP provider, tried before Gmail. Needs a domain you own.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- App --------------------------------------------------------------------
# No trailing slash. Links in emails are built from this.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs the "more like this" links. Any long random string
# (`openssl rand -hex 32`). Falls back to the service-role key if unset.
APP_SECRET=

# ---- Inngest (background jobs) ----------------------------------------------
# Leave blank locally: `npm run dev:inngest` needs no keys.
# Production: https://app.inngest.com -> Manage -> Event Keys / Signing Key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Optional ---------------------------------------------------------------
# Raises Dev Pulse's GitHub search limit from 10 to 30 requests a minute. A
# fine-grained token with no permissions at all is enough.
GITHUB_TOKEN=
# Set to 1 to serve the /demo area from a production build. Off by default.
DEVLR_DEMO=

# ===========================================================================
# Delivery platform (docs/DESIGN.md): the worker and the /api/v1 send API.
# Separate infrastructure. The app above does not need any of this.
# ===========================================================================

# Sink: accepts and discards everything. For load testing. Never in production.
SINK_PROVIDER=false
SINK_LATENCY_MS=0
SINK_FAILURE_RATE=0
SMTP_MAX_CONNECTIONS=5

WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=10
WORKER_LEASE_SECONDS=60
WORKER_MIN_IDLE_MS=250
WORKER_MAX_IDLE_MS=5000
WORKER_SHUTDOWN_GRACE_MS=30000
