{
  "name": "devlr",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "tsx --test --watch \"tests/**/*.test.ts\"",
    "dev:inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "jobs:kick": "tsx --env-file=.env.local scripts/kick-jobs.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/db-migrate.ts",
    "db:status": "tsx --env-file=.env.local scripts/db-migrate.ts --status",
    "sources:check": "tsx scripts/check-sources.ts",
    "email:preview": "tsx --env-file=.env.local scripts/preview-issue.ts",
    "email:sample": "tsx scripts/preview-sample.ts",
    "ai:check": "tsx --env-file=.env.local scripts/check-models.ts",
    "guard:scan": "tsx --env-file-if-exists=.env.local scripts/scan-repo.ts",
    "worker": "tsx --env-file=.env.local worker/index.ts",
    "platform:key": "tsx --env-file=.env.local scripts/create-api-key.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@mozilla/readability": "^0.6.0",
    "@react-email/render": "^2.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "cmdk": "^1.1.1",
    "fast-xml-parser": "^5.11.2",
    "inngest": "^4.21.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.49.0",
    "motion": "^12.43.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.13",
    "openai": "^6.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.8",
    "inngest-cli": "^1.45.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.35.4": true,
    "unrs-resolver@1.12.2": true,
    "inngest-cli@1.45.1": true,
    "esbuild": false,
    "protobufjs": false
  },
  "description": "The developer inbox: dev news for your stack, end-of-life warnings, and the repos worth knowing about."
}
